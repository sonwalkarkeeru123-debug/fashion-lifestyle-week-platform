# ============================================
# Fashion & Lifestyle Week Event Platform
# Environment Variables Template
# ============================================
# Copy this file to .env.local for local development
# OR enter these values in Vercel Dashboard → Project → Settings → Environment Variables
# NEVER commit real secrets to GitHub

# --- REQUIRED: Database (Neon PostgreSQL) ---
# Get from: https://console.neon.tech → Project → Connection Details
# Use the pooled connection string for DATABASE_URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional: Unpooled connection (for migrations if needed)
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- REQUIRED: Authentication ---
# Generate a strong random string (e.g. openssl rand -base64 32)
NEXTAUTH_SECRET="your-super-secret-auth-key-change-this-in-production"
NEXTAUTH_URL="https://your-app.vercel.app"
# For local: NEXTAUTH_URL="http://localhost:3000"

# --- REQUIRED: App URL ---
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# --- REQUIRED: Resend Email ---
# Get from: https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Verified sender email (must be verified in Resend dashboard)
RESEND_FROM_EMAIL="noreply@yourdomain.com"
RESEND_FROM_NAME="Fashion Lifestyle Week"

# --- OPTIONAL: Image Storage (Cloudinary recommended) ---
# Get from: https://cloudinary.com → Dashboard
IMAGE_STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Alternative: Use any S3-compatible or leave empty to use local/public folder for demos

# --- OPTIONAL: Other ---
# SESSION_SECRET is not needed if using NextAuth (NEXTAUTH_SECRET covers it)
